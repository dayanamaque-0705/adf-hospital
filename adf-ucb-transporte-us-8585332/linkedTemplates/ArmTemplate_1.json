						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "gold_dim_diagnostico",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT\\n    LTRIM(RTRIM(icd_code)) AS codigo_icd,\\n    diagnosis_description AS descripcion_patologia,\\n    COALESCE(NULLIF(LTRIM(RTRIM(severity)), \\'\\'), \\'No especificada\\') AS nivel_severidad\\nFROM silver.diagnoses\\nWHERE icd_code IS NOT NULL\\n  AND LTRIM(RTRIM(icd_code)) <> \\'\\'',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          diagnostico_key as integer,",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
