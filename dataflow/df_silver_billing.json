{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "idsmonto"
				},
				{
					"name": "cargoestado"
				},
				{
					"name": "fechacosto"
				},
				{
					"name": "split1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          amount = iif(\r",
				"  isNull(amount) || trim(amount) == '' || upper(trim(amount)) == 'NULL',\r",
				"  toDecimal(null(), 12, 2),\r",
				"  toDecimal(\r",
				"    regexReplace(trim(amount), '[^0-9.-]', ''),\r",
				"    12,\r",
				"    2\r",
				"  )\r",
				")) ~> idsmonto",
				"idsmonto derive(charge_type = iif(   isNull(charge_type) || trim(charge_type) == '' || upper(trim(charge_type)) == 'NULL',   toString(null()),   initCap(trim(charge_type)) ),",
				"          payment_status = iif(   isNull(payment_status) || trim(payment_status) == '' || upper(trim(payment_status)) == 'NULL',   toString(null()),   case(     lower(trim(payment_status)) == 'paid', 'Paid',     lower(trim(payment_status)) == 'pending', 'Pending',     lower(trim(payment_status)) == 'unpaid', 'Unpaid',     lower(trim(payment_status)) == 'overdue', 'Overdue',     initCap(trim(payment_status))   ) )) ~> cargoestado",
				"cargoestado derive(payment_date = iif(   isNull(payment_date) || trim(payment_date) == '' || upper(trim(payment_date)) == 'NULL',   toDate(null()),   iif(     year(       coalesce(         toDate(trim(payment_date), 'yyyy-MM-dd'),         toDate(trim(payment_date), 'MMMM dd, yyyy'),         toDate(trim(payment_date), 'dd-MMM-yyyy'),         toDate(trim(payment_date), 'MM/dd/yyyy'),         toDate(trim(payment_date), 'dd-MM-yyyy'),         toDate(trim(payment_date), 'MM-dd-yy')       )     ) < 1900,     toDate(null()),     coalesce(       toDate(trim(payment_date), 'yyyy-MM-dd'),       toDate(trim(payment_date), 'MMMM dd, yyyy'),       toDate(trim(payment_date), 'dd-MMM-yyyy'),       toDate(trim(payment_date), 'MM/dd/yyyy'),       toDate(trim(payment_date), 'dd-MM-yyyy'),       toDate(trim(payment_date), 'MM-dd-yy')     )   ) )) ~> fechacosto",
				"fechacosto split(!isNull(billing_id) && !isNull(admission_id) && !isNull(charge_type) && charge_type != '' && !isNull(amount) && amount > 0 && !isNull(payment_status) && payment_status != '',",
				"     disjoint: false) ~> split1@(validos, nulls)",
				"split1@validos, source2 exists(split1@validos@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> sink1"
			]
		}
	}
}